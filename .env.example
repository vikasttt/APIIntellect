# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# ─── Database (SQLAlchemy asyncpg) ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/smart_client_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096
# ─── Cohere (Reranking) ────────────────────────────────────────────────────────
COHERE_API_KEY=...
COHERE_RERANK_MODEL=rerank-english-v3.0
COHERE_RERANK_TOP_N=5
# ─── Vector Search ─────────────────────────────────────────────────────────────
VECTOR_SEARCH_TOP_K=20
HYBRID_SEARCH_ALPHA=0.7
MULTI_QUERY_COUNT=3
RERANK_ENABLED=true
# ─── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# ─── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx
# ─── Azure Monitor Telemetry ───────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
OTEL_SERVICE_NAME=smart-client-rag
OTEL_SERVICE_VERSION=0.1.0
# ─── Agent / LangGraph ─────────────────────────────────────────────────────────
# psycopg3 plain DSN used by AsyncPostgresSaver + AsyncConnectionPool.
# If not set, derived automatically from DATABASE_URL (strips +asyncpg).
# Must use psycopg3 scheme, e.g.: postgresql://user:pass@host:5432/dbname
AGENT_CHECKPOINTER_DSN=postgresql://postgres:admin@localhost:5432/smart_client_db
# RAG pipeline settings for the agent rag_node (independent of main search):
AGENT_RAG_TOP_K=20
AGENT_RAG_MULTI_QUERY_COUNT=3
AGENT_RAG_RERANK_TOP_N=5
AGENT_RAG_RERANK_ENABLED=true